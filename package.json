{
  "name": "dsa-notes",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first place to keep your DSA practice.",
  "//productName": "Electron derives the app-data folder name from this, not from `name`. Changing it later would strand an existing vault.",
  "productName": "DSA Tracker",
  "author": {
    "name": "Saurya Aditya Sahu",
    "email": "saurya.aditya.sahu@gmail.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "build": "next build",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "build:desktop": "next build && node scripts/prepare-standalone.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:linux": "npm run build:desktop && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "force-graph": "^1.51.4",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
